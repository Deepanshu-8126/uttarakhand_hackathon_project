# ==============================================================================
# DISCOVERY UTTARAKHAND — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env:
#   cp .env.example .env
# Fill in your credentials below. NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Allowed CORS origins (comma-separated).
FRONTEND_URL=http://localhost:5173,http://localhost:80,http://localhost

# Frontend build-time API base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Database connection (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/discovery_uttarakhand?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT, COOKIES, OTP)
# ------------------------------------------------------------------------------
# Generate 64-character random secrets with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OTP_SECRET=your_cryptographic_otp_hmac_secret_here

# ------------------------------------------------------------------------------
# 3. EMAIL SERVICE (NODEMAILER / SMTP) — FOR REAL OTP EMAILS
# ------------------------------------------------------------------------------
# For Gmail: host=smtp.gmail.com, port=587 (or 465), user=you@gmail.com, pass=16-digit-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM="Discovery Uttarakhand" <noreply@discoveryuttarakhand.com>

# ------------------------------------------------------------------------------
# 4. MOBILE SMS SERVICE (PROVIDER ABSTRACTION) — OPTIONAL
# ------------------------------------------------------------------------------
# Providers supported: twilio | fast2sms
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=DISCOVERY

# ------------------------------------------------------------------------------
# 5. MEDIA STORAGE (CLOUDINARY) — OPTIONAL
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 6. AI COPILOT & LLM PROVIDERS — OPTIONAL (Falls back to deterministic engine)
# ------------------------------------------------------------------------------
AI_PROVIDER=deterministic
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
GROQ_ENABLED=false
GROQ_API_KEY=
GEMINI_ENABLED=false
GEMINI_API_KEY=
OPENAI_ENABLED=false
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY (RAZORPAY) — OPTIONAL
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
