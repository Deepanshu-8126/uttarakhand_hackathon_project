pluginManagement {
    def flutterSdkPath = {
        def properties = new Properties()
        def localPropertiesFile = new File(settingsDir, "local.properties")
        if (!localPropertiesFile.exists()) {
            localPropertiesFile = new File(settingsDir.parentFile, "local.properties")
        }
        if (localPropertiesFile.exists()) {
            localPropertiesFile.withReader("UTF-8") { reader ->
                properties.load(reader)
            }
        }
        def path = properties.getProperty("flutter.sdk")
        if (path == null) {
            path = System.getenv("FLUTTER_ROOT")
        }
        if (path == null) {
            def candidate = new File("C:/Users/Deepanshu/flutter")
            if (candidate.exists()) {
                path = candidate.absolutePath
            }
        }
        if (path != null) {
            path = path.replace("\\", "/")
        }
        assert path != null, "flutter.sdk not found in local.properties, FLUTTER_ROOT, or default path"
        return path
    }

    includeBuild("${flutterSdkPath()}/packages/flutter_tools/gradle")

    repositories {
        google()
        mavenCentral()
        gradlePluginPortal()
    }
}

plugins {
    id "dev.flutter.flutter-plugin-loader" version "1.0.0"
    id "com.android.application" version "8.11.1" apply false
    id "org.jetbrains.kotlin.android" version "2.2.20" apply false
}

include ":app"
